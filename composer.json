{
    "name": "hyprpay/payments",
    "description": "Self-contained multi-gateway payment SDK. Drivers: CyberSource Unified Checkout, Fawry, Paymob, PayLink, PayTabs, PayPal, Mastercard MPGS.",
    "type": "library",
    "version": "0.3.3",
    "license": "MIT",
    "homepage": "https://mhjaafar9869.github.io/hyprpay/",
    "support": {
        "docs": "https://mhjaafar9869.github.io/hyprpay/",
        "source": "https://github.com/MHJaafar9869/hyprpay",
        "issues": "https://github.com/MHJaafar9869/hyprpay/issues"
    },
    "keywords": [
        "payments",
        "gateway",
        "cybersource",
        "fawry",
        "paymob",
        "paylink",
        "paytabs",
        "paypal"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/log": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/pipeline": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Hyprpay\\Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyprpay\\Payments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hyprpay\\Payments\\Infrastructure\\GatewayServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:test": "pint --test",
        "rector": "rector",
        "rector:dry": "rector --dry-run",
        "analyse": "phpstan analyse --memory-limit=2G",
        "analyse:baseline": "phpstan analyse --memory-limit=2G --generate-baseline",
        "check": [
            "@format:test",
            "@rector:dry",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
